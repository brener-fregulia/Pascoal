{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pascoal",
  "version": "2026.2.1",
  "identifier": "com.brener-fregulia.pascoal",
  "build": {
    "beforeDevCommand": "npm run dev:ide",
    "beforeBuildCommand": "npm run build:ide",
    "frontendDist": "../src/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pascoal",
        "width": 1600,
        "height": 900,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2OUMxQUVEQTM3MzE5NjAKUldSZ0dYT2o3UnFjdHNoR1ZVMTB3UGRhSkJMZFpkbDlKZTllS1ZKQ21GelBCSk53akZ0eXJERmgK",
      "endpoints": [
        "https://github.com/brener-fregulia/Pascoal/releases/latest/download/latest.json"
      ]
    }
  }
}