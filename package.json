{
  "name": "pascoal",
  "productName": "Pascoal",
  "version": "2026.3.0",
  "description": "Pascal Playground - Pascoal",
  "main": "src/main/main.js",
  "scripts": {
    "dev:ide": "cd src && npx vite",
    "build:ide": "cd src && npx vite build",
    "build:e2e": "cd src-tauri && cargo tauri build --debug --no-bundle --features e2e --config tauri.e2e.conf.json",
    "set-version": "node scripts/set-version.cjs",
    "test:frontend": "cd src && npx vitest run",
    "test:frontend:watch": "cd src && npx vitest",
    "test:frontend:coverage": "cd src && npx vitest run --coverage",
    "test:rust": "cd src-tauri && cargo test --lib",
    "test:rust:coverage": "cd src-tauri && cargo llvm-cov --lib --html",
    "test:pascal": "cd src-tauri && cargo test --test pascal_runner -- --nocapture",
    "test": "npm run test:frontend && npm run test:rust && npm run test:pascal",
    "test:e2e": "wdio run wdio.conf.ts",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brener-fregulia/Pascoal.git"
  },
  "author": "Brener Fregulia",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/brener-fregulia/Pascoal/issues"
  },
  "homepage": "https://github.com/brener-fregulia/Pascoal#readme",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/cli": "^9.19.0",
    "@wdio/local-runner": "^9.19.0",
    "@wdio/mocha-framework": "^9.19.0",
    "@wdio/spec-reporter": "^9.19.0",
    "@wdio/tauri-service": "^1.2.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "paneforge": "^1.0.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7",
    "@wdio/native-utils": "^2.5.0"
  }
}
