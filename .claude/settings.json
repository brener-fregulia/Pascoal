{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git-write.cjs"
            ],
            "timeout": 10,
            "statusMessage": "Checking Git safety policy"
          }
        ]
      }
    ]
  }
}
